; Godot 4.4.1 — Last Bastion vertical slice
config_version=5

[application]
config/name="Grim Salvage: Last Bastion"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/description="A portrait RPG and tower defence prototype"

[display]
window/size/viewport_width=360
window/size/viewport_height=720
window/size/window_width_override=360
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1
window/handheld/allow_small_window=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/default_filters/use_nearest_mipmap_filter=false

[application/config]
